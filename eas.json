{
  "cli": {
    "version": ">= 12.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    // Build interno para o time: release mode, mas instalável por link em vez de
    // loja. No Android sai .apk, que é o que o Firebase App Distribution recebe.
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal" // (enum: production, beta, alpha, internal)
      }
    }
  }
}
